# ============================================================
# ModelSim 通用波形显示脚本
#
# 使用方法：
#
#   1. 先打开波形数据库：
#
#      vsim -l build/modelsim/wave_transcript -view build/modelsim/simulation.wlf
#
#   2. 在 ModelSim Transcript 中执行：
#
#      do sim/modelsim/wave.do
#
#
# 特点：
#
#   - 不依赖 Testbench 名称
#   - 不依赖 DUT 名称
#   - 不依赖 clk / reset 等信号名称
#   - 自动递归显示 simulation dataset 中所有已记录信号
# ============================================================


# ============================================================
# 1. 清空当前 Wave 窗口
# ============================================================

# catch：
#   即使当前 Wave 窗口为空，也不会因为删除失败而中断脚本。

catch {delete wave *}


# ============================================================
# 2. 加载全部波形
# ============================================================

# simulation:
#   是 simulation.wlf 打开后的 dataset 名称。
#
# /*
#   表示 dataset 下的所有顶层对象。
#
# -r：
#   recursive，递归加入下面所有子模块和信号。
#
# 因此无需知道：
#
#   Testbench 名称
#   DUT 名称
#   信号名称

if {[catch {

    add wave -r simulation:/*

} err]} {

    puts ""
    puts "============================================================"
    puts "错误：无法加载 simulation dataset。"
    puts ""
    puts "请确认已经执行："
    puts ""
    puts "  vsim -l build/modelsim/wave_transcript -view build/modelsim/simulation.wlf"
    puts ""
    puts "详细错误："
    puts "  $err"
    puts "============================================================"
    puts ""

    return
}


# ============================================================
# 3. 自动显示完整波形时间范围
# ============================================================

wave zoom full


# ============================================================
# 4. 完成提示
# ============================================================

puts ""
puts "============================================================"
puts "ModelSim 波形加载完成"
puts "已递归加载 simulation dataset 中的全部已记录信号"
puts "============================================================"
puts ""
